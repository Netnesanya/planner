{
  "name": "flow-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "config": "node --env-file-if-exists=.env.local scripts/write-config.mjs",
    "prestart": "npm run config",
    "start": "ng serve --host 127.0.0.1",
    "prebuild": "npm run config",
    "build": "ng build",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/*.{ts,mjs}\" \"scripts/*.mjs\"",
    "test:mobile": "node tests/mobile-webkit.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
